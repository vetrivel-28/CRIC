          },
          {
            "name": "Credited Wickets",
            "expression": "SUM(v_bowler_career_performance[wickets])",
            "formatString": "0"
          },
          {
            "name": "Economy Rate",
            "expression": "DIVIDE([Runs Conceded] * 6, [Total Legal Balls], BLANK())",
            "formatString": "0.00"
          },
          {
            "name": "Bowling Strike Rate",
            "expression": "DIVIDE([Total Legal Balls], [Credited Wickets], BLANK())",
            "formatString": "0.00"
          },
          {
            "name": "Wicket Rate",
            "expression": "DIVIDE([Credited Wickets], [Total Legal Balls], BLANK())",
            "formatString": "0.000%"
          },
          {
            "name": "Recommended Shortlist",
            "expression": "[Credited Wickets]",
            "formatString": "0"
          },
          {
            "name": "Bowler Career",
            "expression": "[Credited Wickets]",
            "formatString": "0"
          }
        ]
      },
