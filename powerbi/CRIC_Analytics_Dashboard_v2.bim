        ],
        "partitions": [
          {
            "name": "dim_match",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5432\", \"cric_analytics\"),",
                "    Item = Source{[Schema=\"cricket_dim\",Item=\"dim_match\"]}[Data]",
                "in",
                "    Item"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Matches",
            "expression": "DISTINCTCOUNT(dim_match[match_id])",
