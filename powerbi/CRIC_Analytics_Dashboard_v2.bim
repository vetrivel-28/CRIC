      {
        "name": "fact_wicket",
        "columns": [
          {
            "name": "wicket_event_id",
            "dataType": "int64",
            "sourceColumn": "wicket_event_id",
            "summarizeBy": "count"
          },
          {
            "name": "match_id",
            "dataType": "string",
            "sourceColumn": "match_id",
            "summarizeBy": "none"
          },
          {
            "name": "bowler_id",
            "dataType": "string",
            "sourceColumn": "bowler_id",
            "summarizeBy": "none"
          },
          {
            "name": "bowler_name",
            "dataType": "string",
            "sourceColumn": "bowler_name",
            "summarizeBy": "none"
          },
          {
            "name": "kind",
            "dataType": "string",
            "sourceColumn": "kind",
            "summarizeBy": "none"
          },
          {
            "name": "is_bowler_credited",
            "dataType": "boolean",
            "sourceColumn": "is_bowler_credited",
            "summarizeBy": "none"
          },
          {
            "name": "over_phase",
            "dataType": "string",
            "sourceColumn": "over_phase",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_wicket",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5432\", \"cric_analytics\"),",
                "    Item = Source{[Schema=\"cricket_fact\",Item=\"fact_wicket\"]}[Data]",
                "in",
                "    Item"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Wicket Events",
            "expression": "COUNTROWS(fact_wicket)",
            "formatString": "0"
          },
          {
            "name": "Bowler-Credited Wickets",
            "expression": "CALCULATE(COUNTROWS(fact_wicket), fact_wicket[is_bowler_credited] = TRUE())",
            "formatString": "0"
          },
          {
            "name": "Non-Bowler-Credited Dismissals",
            "expression": "[Total Wicket Events] - [Bowler-Credited Wickets]",
            "formatString": "0"
          }
        ]
      },
      {
