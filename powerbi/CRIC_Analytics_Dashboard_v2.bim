            "dataType": "decimal",
            "sourceColumn": "runs_conceded_by_bowler",
            "summarizeBy": "sum"
          },
          {
            "name": "wickets",
            "dataType": "int64",
            "sourceColumn": "wickets",
            "summarizeBy": "sum"
          },
          {
            "name": "economy",
            "dataType": "decimal",
            "sourceColumn": "economy",
            "summarizeBy": "average"
          },
          {
            "name": "average",
            "dataType": "decimal",
            "sourceColumn": "average",
            "summarizeBy": "average"
          },
          {
            "name": "strike_rate",
            "dataType": "decimal",
            "sourceColumn": "strike_rate",
            "summarizeBy": "average"
          },
          {
            "name": "sample_size_flag",
            "dataType": "string",
            "sourceColumn": "sample_size_flag",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "v_bowler_batter_matchups",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5432\", \"cric_analytics\"),",
                "    Item = Source{[Schema=\"cricket_analytics\",Item=\"v_bowler_batter_matchups\"]}[Data]",
                "in",
                "    Item"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Matchups",
            "expression": "COUNTROWS(v_bowler_batter_matchups)",
            "formatString": "0"
          },
          {
            "name": "Matchup Legal Balls",
            "expression": "SUM(v_bowler_batter_matchups[balls])",
            "formatString": "0"
          },
          {
            "name": "Matchup Runs",
            "expression": "SUM(v_bowler_batter_matchups[runs_conceded_by_bowler])",
            "formatString": "0"
          },
          {
            "name": "Matchup Wickets",
            "expression": "SUM(v_bowler_batter_matchups[wickets])",
            "formatString": "0"
          },
          {
            "name": "Matchup Economy",
            "expression": "DIVIDE([Matchup Runs] * 6, [Matchup Legal Balls], BLANK())",
            "formatString": "0.00"
          },
          {
            "name": "Bowler-Batter Matrix",
            "expression": "[Matchup Economy]",
            "formatString": "0.00"
          },
          {
            "name": "Matchup Table",
            "expression": "[Matchup Economy]",
            "formatString": "0.00"
          },
          {
            "name": "Head-to-Head Evidence",
            "expression": "[Matchup Economy]",
            "formatString": "0.00"
          },
          {
            "name": "Matchup Wickets (Batter Context)",
            "expression": "CALCULATE([Matchup Wickets], USERELATIONSHIP(v_bowler_batter_matchups[batter_id], dim_player[player_id]))",
            "formatString": "0"
          },
          {
            "name": "Matchup Runs (Batter Context)",
            "expression": "CALCULATE([Matchup Runs], USERELATIONSHIP(v_bowler_batter_matchups[batter_id], dim_player[player_id]))",
            "formatString": "0"
          },
          {
            "name": "Matchup Balls (Batter Context)",
            "expression": "CALCULATE([Matchup Legal Balls], USERELATIONSHIP(v_bowler_batter_matchups[batter_id], dim_player[player_id]))",
            "formatString": "0"
          },
          {
            "name": "Matchup Economy (Batter Context)",
            "expression": "CALCULATE([Matchup Economy], USERELATIONSHIP(v_bowler_batter_matchups[batter_id], dim_player[player_id]))",
            "formatString": "0.00"
          }
        ]
      },
