          },
          {
            "name": "Situation Wickets",
            "expression": "SUM(v_bowler_situation_performance[wickets])",
            "formatString": "0"
          },
          {
            "name": "Situation Economy",
            "expression": "DIVIDE([Situation Runs Conceded] * 6, [Situation Legal Balls], BLANK())",
            "formatString": "0.00"
          },
          {
            "name": "Situation Matrix",
            "expression": "[Situation Economy]",
            "formatString": "0.00"
