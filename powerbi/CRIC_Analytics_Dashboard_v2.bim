          },
          {
            "name": "strike_rate",
            "dataType": "decimal",
            "sourceColumn": "strike_rate",
            "summarizeBy": "average"
          },
          {
            "name": "batting_average",
            "dataType": "decimal",
            "sourceColumn": "batting_average",
            "summarizeBy": "average"
          }
        ],
        "partitions": [
          {
            "name": "v_batter_career_performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5432\", \"cric_analytics\"),",
                "    Item = Source{[Schema=\"cricket_analytics\",Item=\"v_batter_career_performance\"]}[Data]",
                "in",
                "    Item"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Batters",
            "expression": "DISTINCTCOUNT(v_batter_career_performance[batter_id])",
            "formatString": "0"
          },
          {
            "name": "Total Runs",
            "expression": "SUM(v_batter_career_performance[runs_scored])",
            "formatString": "0"
          },
          {
            "name": "Total Batting Balls",
            "expression": "SUM(v_batter_career_performance[balls_faced])",
            "formatString": "0"
          },
          {
            "name": "Batting Average",
            "expression": "DIVIDE([Total Runs], SUM(v_batter_career_performance[dismissals]), BLANK())",
            "formatString": "0.00"
          },
          {
            "name": "Batting Strike Rate",
            "expression": "DIVIDE([Total Runs] * 100, [Total Batting Balls], BLANK())",
            "formatString": "0.00"
          },
          {
            "name": "Batter Career",
            "expression": "[Total Runs]",
            "formatString": "0"
          }
        ]
      },
      {
        "name": "v_bowler_batter_matchups",
        "columns": [
          {
            "name": "bowler_id",
