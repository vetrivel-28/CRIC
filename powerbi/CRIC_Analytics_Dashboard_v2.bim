          },
          {
            "name": "Situation Legal Balls",
            "expression": "SUM(v_bowler_situation_performance[balls])",
            "formatString": "0"
          },
          {
            "name": "Situation Runs Conceded",
            "expression": "SUM(v_bowler_situation_performance[runs_conceded])",
