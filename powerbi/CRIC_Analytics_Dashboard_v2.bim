        "partitions": [
          {
            "name": "v_bowler_career_performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5432\", \"cric_analytics\"),",
                "    Item = Source{[Schema=\"cricket_analytics\",Item=\"v_bowler_career_performance\"]}[Data]",
                "in",
                "    Item"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Bowlers",
            "expression": "DISTINCTCOUNT(v_bowler_career_performance[bowler_id])",
            "formatString": "0"
          },
          {
            "name": "Total Legal Balls",
            "expression": "SUM(v_bowler_career_performance[legal_balls])",
